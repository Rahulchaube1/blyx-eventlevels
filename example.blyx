use eventlevels;

fn main() {
    let severity = [9, 17, 13, 21];
    let threshold = 17.0;
    let result = eventlevels_count(severity, threshold);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
