use std::cli;
use eventlevels;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(eventlevels_count([9, 17, 13, 21], 17.0), [2, 21, 1]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(eventlevels_count([], 1.0), [0, -1, -1]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(eventlevels_count([25], 17.0), []) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(eventlevels_count([infinity], 17.0), []) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(eventlevels_count([9, 17, 13, 21], infinity), []) { stderr_line("case 5 failed"); process_exit(1); }
    println!("passed");
}
